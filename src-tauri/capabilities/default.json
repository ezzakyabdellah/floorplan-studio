{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://ollama.com/**" },
        { "url": "https://github.com/**" }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:11434/**" },
        { "url": "http://127.0.0.1:11434/**" }
      ]
    },
    "fs:default",
    "fs:allow-open",
    "fs:allow-applocaldata-read",
    "fs:allow-applocaldata-write",
    "fs:allow-applocaldata-write-recursive",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" }
      ],
      "deny": [
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.kube/**" },
        { "path": "$HOME/.docker/**" },
        { "path": "$HOME/.azure/**" },
        { "path": "$HOME/.gcloud/**" },
        { "path": "$HOME/.config/**" },
        { "path": "$HOME/.env" },
        { "path": "$HOME/.env/**" },
        { "path": "$HOME/.netrc" },
        { "path": "$HOME/.npmrc" },
        { "path": "$HOME/.local/share/keyrings/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" }
      ],
      "deny": [
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.kube/**" },
        { "path": "$HOME/.docker/**" },
        { "path": "$HOME/.azure/**" },
        { "path": "$HOME/.gcloud/**" },
        { "path": "$HOME/.config/**" },
        { "path": "$HOME/.env" },
        { "path": "$HOME/.env/**" },
        { "path": "$HOME/.netrc" },
        { "path": "$HOME/.npmrc" },
        { "path": "$HOME/.local/share/keyrings/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" }
      ],
      "deny": [
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.kube/**" },
        { "path": "$HOME/.docker/**" },
        { "path": "$HOME/.azure/**" },
        { "path": "$HOME/.gcloud/**" },
        { "path": "$HOME/.config/**" },
        { "path": "$HOME/.env" },
        { "path": "$HOME/.env/**" },
        { "path": "$HOME/.netrc" },
        { "path": "$HOME/.npmrc" },
        { "path": "$HOME/.local/share/keyrings/**" }
      ]
    }
  ]
}
