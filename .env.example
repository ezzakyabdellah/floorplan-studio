# FloorPlan Studio local configuration.
#
# The app creates this file automatically in its per-user config directory:
#   Windows: %APPDATA%\com.floorplan.studio\.env
#   macOS:   ~/Library/Application Support/com.floorplan.studio/.env
#   Linux:   ~/.config/com.floorplan.studio/.env
#
# Fill GEMINI_API_KEY, save the file, then use "Reload" in the app's warning
# banner. Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
